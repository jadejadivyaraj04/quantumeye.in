# EmailJS — restrict these to the production domain in the EmailJS dashboard.
# Without them the contact form falls back to opening a mailto: draft.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Published content. Unset (the default) means the site renders the copy
# compiled into the bundle and makes no request at all. Set it to the public
# URL of content.json once the dashboard is publishing.
VITE_CONTENT_URL=
